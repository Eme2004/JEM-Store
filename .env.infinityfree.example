# --------------------------------------------------
# Plantilla de entorno para InfinityFree (producción)
# --------------------------------------------------
#
# Este archivo NO contiene secretos reales y es seguro de commitear.
# El workflow de despliegue NO sube ningún .env (está excluido a propósito).
#
# Pasos para usarlo:
#   1. Copia este archivo a tu computadora y renómbralo a ".env".
#   2. Genera una APP_KEY real y única para producción:
#        php artisan key:generate --show
#      (solo imprime la clave, no modifica ningún archivo local)
#      Pega el valor generado en APP_KEY= abajo.
#   3. Genera un DEPLOY_TOKEN propio, por ejemplo con:
#        php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
#      Pega el valor en DEPLOY_TOKEN= abajo. Lo usa public/deploy-migrate.php
#      para poder correr migraciones sin acceso SSH (InfinityFree free no
#      lo tiene). Ver comentarios en ese archivo.
#   4. Sube el archivo ya completado como ".env" a /htdocs por FTP o por el
#      administrador de archivos de InfinityFree. Solo se hace una vez: el
#      workflow de GitHub Actions nunca toca ni sobrescribe este archivo.

APP_NAME="JEM Store"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://jemstore.infinityfree.io

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Sin valor: Laravel usa database/database.sqlite dentro del propio
# proyecto de forma automática. No hace falta una ruta absoluta.
DB_CONNECTION=sqlite

# "file" en vez de "database" porque InfinityFree free no tiene worker de
# colas ni shell para correr migraciones de las tablas sessions/cache/jobs.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@jemstore.infinityfree.io"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Token propio (no es un GitHub Secret) para public/deploy-migrate.php.
# Ver el paso 3 arriba.
DEPLOY_TOKEN=
