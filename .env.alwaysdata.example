# --------------------------------------------------
# Plantilla de entorno para alwaysdata (producción)
# --------------------------------------------------
#
# Este archivo NO contiene secretos reales y es seguro de commitear.
# El workflow de despliegue NUNCA sube ni sobrescribe el .env real del
# servidor (está excluido a propósito en .github/workflows/deploy.yml).
#
# Pasos para usarlo (una sola vez, manualmente por SSH):
#   1. Copia este archivo a /home/jemstore/JEM-Store/.env en el servidor.
#   2. Genera una APP_KEY real y única para producción:
#        php artisan key:generate --show
#      (solo imprime la clave, no modifica ningún archivo local)
#      Pega el valor generado en APP_KEY= abajo.
#   3. Guarda el archivo como ".env" en /home/jemstore/JEM-Store/.env.

APP_NAME="JEM Store"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://jemstore.alwaysdata.net

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=sqlite
# La base vive en database/database.sqlite dentro del propio proyecto.
# NO se toca ni se reemplaza en el deploy automático.

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@jemstore.alwaysdata.net"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------
# Braintree (SOLO sandbox — nunca production)
# --------------------------------------------------
# Sin estas 3 variables, el checkout usa una pasarela simulada equivalente
# y sigue funcionando, solo que sin transacciones reales de Braintree.
# Pega aquí las credenciales de tu cuenta Braintree SANDBOX (nunca las
# subas a Git; este archivo es solo la plantilla).
BRAINTREE_ENV=sandbox
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=
# Opcional: solo si el sandbox tiene un merchant account adicional en CRC.
BRAINTREE_MERCHANT_ACCOUNT_ID_CRC=
