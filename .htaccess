# --------------------------------------------------
# JEM Store - Reenvío para hosting sin document root configurable
# --------------------------------------------------
#
# InfinityFree (y la mayoría de hostings compartidos gratuitos) fijan
# el document root en /htdocs y no permiten apuntarlo a /htdocs/public,
# que es donde Laravel realmente sirve la app.
#
# NO borrar public/.htaccess: ese sigue siendo el que enruta hacia
# index.php dentro de /public.
#
# Orden importa: la regla de /storage debe ir ANTES que la regla
# genérica de /public, si no la genérica la captura primero y busca
# un public/storage/... que no existe (InfinityFree no soporta el
# symlink de "php artisan storage:link" sobre FTP).

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Sirve archivos públicos (ej. imágenes de producto) directamente
    # desde storage/app/public, sin depender de un symlink.
    RewriteRule ^storage/(.*)$ /storage/app/public/$1 [END]

    # Todo lo demás se reenvía internamente a /public.
    RewriteRule (.*) /public/$1 [L]
</IfModule>
